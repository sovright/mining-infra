# 1.88 = let-chains stabilization floor (zcash-template-provider uses RFC 2497 let-chains); CI floats stable, this pin is intentional.
FROM rust:1.88-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cargo build --release -p sovright-v1-stratum-proxy

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 sovright
USER sovright
COPY --from=builder /src/target/release/sovright-v1-stratum-proxy /usr/local/bin/translator-proxy
ENTRYPOINT ["/usr/local/bin/translator-proxy"]
